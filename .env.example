# ==============================================================================
# QueueSmart Unified Monorepo Environment Configuration (.env.example)
# Copy this file to `.env` in the root or individual packages for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server Configuration (/server)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# PostgreSQL Connection Strings (Supabase / Neon / Local Postgres)
# DATABASE_URL: Transaction pooler URL (e.g., Supabase port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct database connection string for migrations (port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Redis Cache & PubSub (Upstash Redis / Redis Cloud / Local Redis)
# If omitted or empty, QueueSmart seamlessly falls back to high-performance in-memory cache simulator.
REDIS_URL="rediss://default:[PASSWORD]@[REGION].upstash.io:6379"

# JWT Authentication Secrets (Generate with: `openssl rand -base64 32`)
JWT_ACCESS_SECRET="generate_at_least_32_characters_random_string_for_access_token_secret"
JWT_REFRESH_SECRET="generate_at_least_32_characters_random_string_for_refresh_token_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Allowed CORS Origins for Portals
CUSTOMER_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"

# ------------------------------------------------------------------------------
# 2. Frontend Applications (/apps/customer-portal and /apps/admin-portal)
# ------------------------------------------------------------------------------
# Backend REST API endpoint (used by both portals)
VITE_API_URL="http://localhost:5000/api/v1"

# Backend Socket.IO endpoint for live real-time queues & displays
VITE_SOCKET_URL="http://localhost:5000"

# Mock Mode: Set to 'false' to connect to live backend API, 'true' for local zero-backend demo mode
VITE_USE_MOCKS="false"

# Application Environment ('development' | 'staging' | 'production')
VITE_APP_ENV="development"

# Sentry Error Monitoring DSN (Optional)
VITE_SENTRY_DSN=""

# Web Push Notifications VAPID Key (Optional, for browser background push)
VITE_FIREBASE_VAPID_KEY=""
