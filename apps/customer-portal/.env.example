# QueueSmart Citizen Portal Environment Configuration

# Base URL for backend Express REST API (Base route: /api/v1)
VITE_API_URL=http://localhost:5000/api/v1

# Socket.IO Gateway URL for real-time ticket alerts
VITE_SOCKET_URL=http://localhost:5000

# Set to true to run against reactive in-memory mock engine (zero backend required for evaluation)
VITE_USE_MOCKS=true

# Application deployment environment (development | staging | production)
VITE_APP_ENV=development

# Optional: Sentry DSN for error boundary crash logging (strictly ID-only, zero-PII)
VITE_SENTRY_DSN=

# Optional: Firebase Web Push VAPID Key (Public Key) for Web Push notifications
VITE_FIREBASE_VAPID_KEY=
