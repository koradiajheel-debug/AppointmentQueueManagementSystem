    "prisma:seed": "tsx prisma/seed.ts",
    "test": "jest --runInBand --detectOpenHandles"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@queuesmart/shared": "*",
    "@socket.io/redis-adapter": "^8.3.0",
